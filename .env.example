# Banco: "sqlite" (dev local, sem Docker) ou "mysql" (produção / docker compose)
DB_CLIENT=sqlite
SQLITE_FILE=./dev.sqlite
DATABASE_URL=mysql://passaporte:passaporte@localhost:3306/passaporte

# Segredo para assinar o cookie de sessão (gere um valor aleatório longo)
JWT_SECRET=troque-isto

# Provedor de IA padrão: "claude" ou "gemini" (cada família pode trocar nas configurações)
AI_DEFAULT_PROVIDER=claude

# Claude (Anthropic)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_FAST_MODEL=claude-haiku-4-5

# Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Limite diário de chamadas de IA por membro
AI_DAILY_LIMIT=150

PORT=3001

# Fuso da família: define o "hoje", a sequência de dias e o horário do lembrete
APP_TZ=America/Sao_Paulo

# Frases nativas novas (Tatoeba, i+1) que entram na revisão por dia
NEW_CARDS_PER_DAY=8

# Onde guardar os áudios nativos baixados do Tatoeba
AUDIO_CACHE_DIR=./audio-cache

# Notificações (Web Push). Se ficarem vazias, o app gera as chaves e guarda no banco.
# VAPID_SUBJECT precisa ser um e-mail (mailto:) ou site seu — o Safari/iPhone exige.
VAPID_SUBJECT=mailto:seu-email@exemplo.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
